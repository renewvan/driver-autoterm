[Unit]
Description=driver-heater MQTT device
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/driver-heater
ExecStart=/opt/driver-heater/.venv/bin/python -m driver_heater.main --config /opt/driver-heater/config.ini
Restart=on-failure
RestartSec=5
User=renewvan

[Install]
WantedBy=multi-user.target
