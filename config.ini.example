; driver-autoterm — local configuration
; ======================================
; Copy this file to config.ini and override only what differs from
; config.default.ini. config.ini is gitignored — it holds this
; installation's real MQTT broker host and any hardware-specific settings.

[mqtt]
host = 192.168.1.10

[device]
id = air2d
name = Heater
serial_device = /dev/ttyAUTOTERM
; WARNING: the broker accepts anonymous clients. With this true, anyone who can
; reach it can start and stop the heater. Keep the broker on the van's own network.
commands_enabled = false
; Init frames (0x1C/0x04/0x06) on connect. Not needed on an AIR 2D; leave false.
send_init = false
