[Unit]
Description=driver-autoterm MQTT device
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/driver-autoterm
ExecStart=/opt/driver-autoterm/.venv/bin/python -m driver_autoterm.main --config /opt/driver-autoterm/config.ini
Restart=on-failure
RestartSec=5
User=renewvan
SupplementaryGroups=dialout

[Install]
WantedBy=multi-user.target
